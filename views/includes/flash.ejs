
<% if(success && success.length) { %><div class="alert alert-success col-6 offset-2" role="alert">
<%= success %>
<button 
type="button"
class="btn-close"
data-bs-dismiss="alert"
aria-label="close"
style="cursor: pointer;
padding: 0;
display:flex;
position: absolute;
    top: 16px;
    right: 10px;"
></button>
</div>
<% } %>

<% if(error && error.length) { %><div class="alert alert-danger col-6 offset-2" role="alert">
<%= error %>
<button 
type="button"
class="btn-close"
data-bs-dismiss="alert"
aria-label="close"
style="cursor: pointer;
padding: 0;
display:flex;
position: absolute;
    top: 16px;
    right: 10px;"
></button>
</div>
<% } %>